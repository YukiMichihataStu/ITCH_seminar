      </header>
      
      <div class="screenshot-container" style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 12px; justify-items: center; align-items: center; margin-top: 10px;">
        <!-- PC版（左） -->
        <div class="compare-screenshot" style="max-width: 240px; height: 160px; border: 1px solid var(--line); background: #fff; display: flex; align-items: center; justify-content: center; position: relative;">
          <img src="assets/image copy 13.png" alt="PC版（悪い例）" style="width: 100%; height: 100%; object-fit: contain;">
          <span style="position: absolute; bottom: 4px; left: 4px; background: rgba(5,5,16,0.6); color: #fff; padding: 2px 6px; font-size: 10px; border-radius: 4px; font-weight: bold;">PC版</span>
        </div>
        <!-- SP版（右） -->
        <div class="compare-screenshot" style="max-width: 110px; height: 200px; border: 1px solid var(--line); background: #fff; display: flex; align-items: center; justify-content: center; position: relative;">
